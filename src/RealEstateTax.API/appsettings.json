{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=retax_db;Username=superuser;Password=Admin@12345"
  },
  "Jwt": {
    "Secret": "CHANGE_ME_AT_LEAST_32_CHARS_LONG_JWT_SECRET_KEY",
    "Issuer": "RealEstateTaxPlatform",
    "Audience": "RealEstateTaxPlatform",
    "ExpiryMinutes": "60"
  },
  "Storage": {
    "LocalPath": "/var/retax/uploads",
    "BaseUrl": "/files"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://retax.gov.eg"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "RealIpHeader": "X-Real-IP",
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 20
      },
      {
        "Endpoint": "*:/api/auth/*",
        "Period": "1m",
        "Limit": 10
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "MLService": {
    "BaseUrl": "http://ml_service:8001",
    "InternalSecret": "CHANGE_ME_ML_INTERNAL_SECRET"
  },
  "FeatureManagement": {
    "GpsCapture": true,
    "OfflineSync": true,
    "GeoFencing": true,
    "RouteOptimization": false,
    "MLRiskScoring": false,
    "FraudDetection": false,
    "DuplicateDetection": false,
    "ValuationPrediction": false,
    "UnregisteredBuildingDetection": false,
    "GeoClusteringDashboard": false
  }
}
