# ══════════════════════════════════════════════════════════════════════════════
# ReTax — Environment Variables Template
# Copy this file to .env and fill in real values before running docker compose
# NEVER commit .env to git — it is already in .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=retax_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=retax_db

# ── JWT Authentication ────────────────────────────────────────────────────────
# Must be at least 32 random characters
JWT_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS_JWT_SECRET_KEY_HERE
JWT_EXPIRY_MINUTES=60

# ── ML Service ────────────────────────────────────────────────────────────────
ML_INTERNAL_SECRET=CHANGE_ME_ML_INTERNAL_SECRET

# ── Application ───────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── pgAdmin (optional — only used with --profile dev) ─────────────────────────
PGADMIN_EMAIL=admin@retax.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
